{
  "schemaVersion": 1,
  "id": "auto-spear",
  "version": "${version}",
  "name": "Auto Spear",
  "description": "AutoSpear module for Meteor Client: dive-bomb spear charges with an elytra, jabs on foot.",
  "authors": [
    "Arsonist-567"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "arsonist.autospear.AutoSpearAddon"
    ]
